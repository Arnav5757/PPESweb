# Server Port configuration
PORT=5000

# MongoDB Connection String (e.g. mongodb+srv://user:pass@cluster...)
MONGODB_URI=<your_mongodb_connection_string>

# JWT Authentication Secret Key (Generate a strong secure random string)
JWT_SECRET=<generate_a_secure_random_secret>

# Frontend Client Origin URL (for secure CORS mapping)
CLIENT_URL=http://localhost:5173
